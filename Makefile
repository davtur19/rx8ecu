# RX-8 ECU — self-contained byte-exact reassembly of the stock ROM.
# Root-level build: everything is resolved relative to this repo root.
#   tools/         rom_rebuild.py, organize_src.py, xmap_names.py, verify_all.sh,
#                  get_toolchain.sh, disasm_sh2e.py, sh2emu.py, rom2asm.py,
#                  denso_ck.py, mazda_security.py, ... and the local sh-elf
#                  binutils install at tools/toolchain/usr/bin
#   roms/stock/    the 9 PUBLIC stock ROM images (10th, [REDACTED], kept private)
#   src/           the 9 annotated sources (regenerated by `make src`)
#   symbols/       symbols*.csv + cal_tables.csv + callgraph.csv
#   analysis/      data_regions_60E1D400.{csv,md}
#   c/             C lifts, tests, verified_addrs.txt
#
# Toolchain: capstone (SH) + sh-elf binutils. One-time, no root:
#   ./tools/get_toolchain.sh
# (the repo ships a local install at tools/toolchain/usr/bin; the script is
#  idempotent and just confirms it; tools/toolchain/ is git-ignored).
#
#   make            rebuild roms/stock/60E1D400.bin -> build/out.bin
#   make verify     cmp build/out.bin against the ROM (byte-exact check)
#   make verify-all rebuild + byte-exact check for ALL 9 public stock ROMs (./tools/verify_all.sh)
#   make src        annotated source (60E1D400, equinox+IDA names) -> src/
#   make c-test     behavior-equivalence tests (host compiler)
#   make c-emu      emulator cross-checks (c/tests/verify_emu.py)
#   make ROM=roms/stock/<id>.bin verify   # any image in the dataset
#   make clean
#
# Catalog tooling (orchestration for the classifier / catalog / badges):
#   make all        catalog + classify + badges + test (full catalog pipeline)
#   make catalog    regen symbols/CATALOG_MASTER.csv + CATALOG_STATUS.md + NAMES_STATUS.md
#   make classify   regen symbols/FUNCTION_CATEGORIES.csv (hybrid classifier)
#   make badges     regen README progress badges + MANIFEST rows (from CATALOG_MASTER)
#   make test       Python regression suites (repo pattern: plain python3, see below)
#
# NOTE: the pre-release Makefile had a private personal-ROM target for the
# owner's own ECU ([REDACTED]). That ROM is kept private now, so those targets
# were dropped; `make verify ROM=...` still works for any public ROM.

ROM   ?= roms/stock/60E1D400.bin
BUILD ?= build

TOOLS     := $(abspath tools)
SYMBOLS   := $(abspath symbols)
CSRC      := $(abspath c)
ROMDIR    := $(abspath roms/stock)

# --- Toolchain resolution (self-contained; no ~/.bashrc dependency) ---
# Search order:
#   1. canonical local install: tools/toolchain/usr/bin  (what get_toolchain.sh produces)
#   2. legacy layout:           tools/toolchain/root/usr/bin (older get_toolchain.sh)
#   3. whatever is already on PATH
# The chosen dir is prepended to PATH for every recipe, so `make` works even
# when sh-elf binutils is nowhere on the user's PATH.
LOCAL_TC  := $(CURDIR)/tools/toolchain/usr/bin
LEGACY_TC := $(CURDIR)/tools/toolchain/root/usr/bin
ENV_PATH  := $(PATH)
ifneq ($(wildcard $(LOCAL_TC)/sh-elf-as),)
  TC := $(LOCAL_TC)
else ifneq ($(wildcard $(LEGACY_TC)/sh-elf-as),)
  TC := $(LEGACY_TC)
else
  TC :=
endif
# NB: capture $(PATH) into ENV_PATH above BEFORE assigning to PATH — a makefile
# assignment to PATH shadows the environment value, so `export PATH := ...$(PATH)`
# would self-reference and expand empty.
export PATH := $(if $(TC),$(TC):$(ENV_PATH),$(ENV_PATH))

.PHONY: build all verify verify-all src c-test c-emu test test-fast catalog classify badges clean

# Default target: rebuild the stock ROM (documented `make` behavior).
build: $(BUILD)/out.bin

$(BUILD)/out.bin: $(TOOLS)/rom_rebuild.py $(ROM)
	python3 $(TOOLS)/rom_rebuild.py --rom $(ROM) --asm $(BUILD)/rom.s --out $@

verify: $(BUILD)/out.bin
	cmp $(BUILD)/out.bin $(ROM) && echo "OK: byte-exact rebuild of $(ROM)"

verify-all:
	./tools/verify_all.sh

# --- annotated source (regenerate into src/) ---
# xmap: transfer equinox (60E0FC00 hand) names across ROMs by content signature.
# Inputs are the surviving public CSVs (symbols.csv / *_xmap.csv / *_idamap.csv
# were moved to private storage; 60E1D400's own symbols ship as _ida.csv).
symbols/symbols_60E1D400_merged.csv: symbols/symbols_60E1D400_ida.csv symbols/symbols_60E0FC00.csv $(TOOLS)/xmap_names.py
	python3 $(TOOLS)/xmap_names.py --src-rom $(ROMDIR)/60E0FC00.bin --src-syms symbols/symbols_60E0FC00.csv --dst-rom $(ROMDIR)/60E1D400.bin --dst-syms symbols/symbols_60E1D400_ida.csv --out $@

# annotated source: name = equinox hand (high) where content-matched, else IDA (provisional)
src: symbols/symbols_60E1D400_merged.csv symbols/cal_tables.csv $(TOOLS)/organize_src.py
	python3 $(TOOLS)/organize_src.py --rom $(ROMDIR)/60E1D400.bin \
	  --symbols symbols/symbols_60E1D400_merged.csv --cal symbols/cal_tables.csv \
	  --regions analysis/data_regions_60E1D400.csv --out src/60E1D400_annotated.s

# Track A: behavior-equivalence tests (host compiler; no SH toolchain needed)
c-test:
	@for t in c/tests/test_*.c; do \
	  b=$$(basename $$t .c); s=$${b#test_}; echo "== $$s =="; \
	  cc -O2 c/$$s.c $$t -o /tmp/$$b && /tmp/$$b || exit 1; \
	done

# verify each C lift against the emulated ROM (tools/sh2emu.py)
c-emu:
	python3 c/tests/verify_emu.py

# Python regression suites: disassembler decode families (incl. the GNU-as bulk
# round-trip), emulator decode families, and the track-A C<->emulator
# cross-check.  Failure of any suite aborts with non-zero status.
#
# NOTE: test_decode_families.py needs sh-elf-as on PATH for the bulk round-trip;
# `make test` gets it from tools/toolchain/usr/bin (PATH setup above).  If you
# run the suites by hand with system python, install capstone (for disasm_sh2e)
# and put the sh-elf binutils on PATH, e.g.:
#   PATH=tools/toolchain/usr/bin:$$PATH python3 tools/tests/test_decode_families.py
test:
	@for t in \
	  tools/tests/test_decode_families.py \
	  tools/tests/test_emulator_families.py \
	  c/tests/verify_emu.py; do \
	  echo "== $$t =="; python3 $$t || exit 1; \
	done
	@echo "test: all suites passed"

# Parallel runner for the full Python regression suite (all c/tests/test_*.py
# + tools/tests/test_*.py + the C<->emulator cross-check).  Same coverage as
# the serial loops, just concurrent.  Use -j to tune workers.
test-fast:
	python3 tools/run_tests_parallel.py c/tests/verify_emu.py

# --- Catalog tooling: classifier + master catalog + badges (deterministic) ---
# Run from the repo root. Both generators are idempotent: a second run produces
# no further diff (guarded in CI by `git diff --exit-code` on the four
# catalog artifacts). tools/verify_roms.py does not exist in this repo, so no
# `verify` target is provided here.
all: catalog classify badges test

catalog:
	python3 tools/gen_catalog.py

classify:
	python3 tools/classify_functions.py

badges:
	python3 tools/gen_badges.py

clean:
	rm -rf $(BUILD) src/*.o src/*.elf src/*.bin
