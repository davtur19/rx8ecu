# Local Makefile for the RX-8 ECU Firmware Explorer (web/explorer/).
#
# This is a LOCAL-ONLY convenience Makefile that lives inside web/explorer/.
# It is NOT the root rx8ecu Makefile. It needs nothing but `make` + Python
# stdlib (python3). The site itself is generated by build_site.py (deterministic).
#
# Quick start:
#     make serve          # build + serve dist/ on http://localhost:8000/
#     make serve-port PORT=8080   # same, on a custom port
#     make build          # just regenerate dist/
#     make clean          # remove dist/
#     make check          # sanity-check dist/ + data.json

PORT ?= 8000

PYTHON ?= python3
BUILD  := $(PYTHON) build_site.py

.PHONY: build serve serve-port clean check

## build — regenerate dist/ (identical to what CI publishes on GitHub Pages)
build:
	$(BUILD)

## serve — build, then serve dist/ with http.server on http://localhost:$(PORT)/
serve: build
	cd dist && $(PYTHON) -m http.server $(PORT)

## serve-port — explicit port variant: `make serve-port PORT=8080`
serve-port: build
	cd dist && $(PYTHON) -m http.server $(PORT)

## clean — remove the generated dist/ directory
clean:
	rm -rf dist

## check — verify dist/ exists, dist/explorer/data.json parses, and the per-model
## value files (dist/explorer/models/*.json) exist and parse as JSON
check:
	@test -d dist || { echo "ERROR: dist/ not found - run 'make build' first"; exit 1; }
	@test -d dist/explorer || { echo "ERROR: dist/explorer/ not found - run 'make build' first"; exit 1; }
	@test -f dist/index.html || { echo "ERROR: dist/index.html (landing page) not found"; exit 1; }
	@test -f dist/explorer/data.json || { echo "ERROR: dist/explorer/data.json not found - run 'make build' first"; exit 1; }
	@$(PYTHON) -c "import json; d = json.load(open('dist/explorer/data.json', encoding='utf-8')); c = d['meta']['counts']; m = d['meta']['models']; am = d['meta']['addr_map']; assert len(m) == c['models'] == 9, 'models != 9'; assert len(am) == 9, 'addr_map != 9 models'; assert c['addr_map_entries'] == c['tables_rows'] * c['models'], 'addr_map entries mismatch'; print('OK: dist/explorer/data.json valid (%(symbols)s symbols, %(edges)s edges, %(tables_rows)s table rows, %(docs_total)s docs, %(subsystems)s subsystems, %(models)s models)' % c)"
	@$(PYTHON) -c "import json; d = json.load(open('dist/explorer/data.json', encoding='utf-8')); c = d['meta']['counts']; assert c['symbols'] == 6083, 'symbols %r != 6083' % c['symbols']; assert c['edges'] == 6953, 'edges %r != 6953' % c['edges']; assert c['edges_bsr'] == 758, 'bsr %r != 758' % c['edges_bsr']; assert c['edges_ref'] == 6195, 'ref %r != 6195' % c['edges_ref']; assert c['tables_rows'] == 1209, 'tables_rows %r != 1209' % c['tables_rows']; assert c['tables_axes'] == 661, 'tables_axes %r != 661' % c['tables_axes']; assert c['addr_map_entries'] == 10881, 'addr_map %r != 10881' % c['addr_map_entries']; assert c.get('symbols_invalid', 0) == 0, 'symbols_invalid %r' % c.get('symbols_invalid'); assert c.get('edges_invalid', 0) == 0, 'edges_invalid %r' % c.get('edges_invalid'); print('OK: ground-truth counts (symbols 6083, edges 6953 bsr 758/ref 6195, tables_rows 1209, tables_axes 661, addr_map 10881)')"
	@$(PYTHON) -c "import csv; fc = {int(r['addr'], 16): r['name'].strip() for r in csv.DictReader(open('../../symbols/FUNCTION_CATEGORIES.csv', encoding='utf-8-sig', errors='replace')) if (r.get('name') or '').strip()}; import json; d = json.load(open('dist/explorer/data.json', encoding='utf-8')); sym = {s['a']: s['n'] for s in d['symbols']}; bad = [(a, fc[a], sym.get(a)) for a in fc if sym.get(a) != fc[a]]; assert not bad, 'FC-name mismatches: %d e.g. %r' % (len(bad), bad[:3]); print('OK: FC↔data.json names agree (%d addrs)' % len(fc))"
	@$(PYTHON) -c "import csv; cal = {int(r['address'], 16): r['name'].strip() for r in csv.DictReader(open('../../symbols/cal_tables.csv', encoding='utf-8', errors='replace'))}; mp = list(csv.DictReader(open('data/table_addr_map_long.csv', encoding='utf-8', errors='replace'))); assert len(mp) == 10881, 'map rows %d != 10881' % len(mp); bad = [r for r in mp if r['table_id'] != cal.get(int(r['baseline_addr'], 16))]; assert not bad, 'cal↔map name mismatches: %d e.g. %r' % (len(bad), bad[:2]); print('OK: cal↔map names agree (10881 rows, addr-keyed)')"
	@$(PYTHON) -c "import json, os, glob; files = sorted(glob.glob('dist/explorer/models/*.json')); assert files, 'no model files'; [json.load(open(f, encoding='utf-8')) for f in files]; assert len(files) == 8, 'expected 8 model files (D400 stays in data.json), got %d' % len(files); print('OK: dist/explorer/models/*.json valid (%d files)' % len(files))"
